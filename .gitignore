# ── Сборка: только в корне ────────────────────────────────────────────────
# Ведущий слэш обязателен. Без него `bin/` вырезал src/bin/ вместе с
# исходниками, а `build/` — вложенные каталоги сборки.
/build/
/Build/
/out/
/dist/
/target/
/bin/
/obj/
/x64/
/x86/
/Debug/
/Release/
/logs/

# ── CMake ──────────────────────────────────────────────────────────────────
/CMakeFiles/
/CMakeCache.txt
/cmake_install.cmake
/CMakeUserPresets.json
/_deps/
/FetchContent/
/compile_commands.json

# ── Unreal ─────────────────────────────────────────────────────────────────
/Binaries/
/Intermediate/
/DerivedDataCache/
/Saved/

# ── Компиляция ────────────────────────────────────────────────────────────
# Эти расширения режутся ТОЛЬКО вне каталога lib/ и third_party/:
# вендорённые import-библиотеки и заголовки — часть исходников.
/*.exe
/*.dll
/*.lib
/*.a
/*.o
/*.obj
/*.pdb
*.o
*.obj
*.pdb
*.ilk
*.exp
*.pyc
*.class
*.jar
*.apk
*.unity
*.meta

# ── VCS и редакторы ───────────────────────────────────────────────────────
/.git
/.vs/
/.vscode/
/.idea/
/*.user
/*.suo
*.swp
*~
*.bak
*.tmp
*.orig
*.rej
Thumbs.db
Desktop.ini
.DS_Store

# ── Логи ──────────────────────────────────────────────────────────────────
*.log
/scan_log_*.txt

# ── Секреты: никогда не коммитить ─────────────────────────────────────────
.env
.env.*
*.pem
*.key
*.pfx
*.keystore
/id_rsa*
/application-local.yml

# ── Служебные файлы пайплайна ─────────────────────────────────────────────
# README.original.md и README.public.md — артефакты генерации каталога.
# В публичном репозитории они не нужны и выглядят как мусор: старый
# продающий текст лежит рядом с новым.
/README.original.md
/README.public.md
